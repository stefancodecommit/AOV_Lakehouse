# Copy to .env (not in git) to change these; docker compose reads .env automatically.

# Containers run as this user, so files they write in lakehouse/ belong to you.
# Find yours with: id -u ; id -g
HOST_UID=1000
HOST_GID=1000

# Dagster's run-history database (only reachable inside Docker)
POSTGRES_USER=dagster
POSTGRES_PASSWORD=dagster
POSTGRES_DB=dagster

# Model for the KVK chat agent (docker compose --profile agent)
OLLAMA_MODEL=qwen2.5:7b

# Where Ollama keeps its models. Default: a Docker volume (downloaded on first start).
# To reuse models already on this machine (e.g. from a local Ollama install):
# OLLAMA_DIR=/home/<you>/.ollama
